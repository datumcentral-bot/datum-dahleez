able cotton, this oversized fit hoodie offers everyday comfort with elevated appeal. Part of a limited edition series of 100 pieces globally.\u003c\/span\u003e\u003c\/p\u003e","brand":"Datum Dahleez STORE","offers":[{"title":"S","offer_id":52202164126043,"sku":"SW3115-NAVYS","price":140.0,"currency_code":"EUR","in_stock":true},{"title":"M","offer_id":52202164158811,"sku":"SW3115-NAVYM","price":140.0,"currency_code":"EUR","in_stock":true},{"title":"L","offer_id":52202164191579,"sku":"SW3115-NAVYL","price":140.0,"currency_code":"EUR","in_stock":true},{"title":"XL","offer_id":52202164224347,"sku":"SW3115-NAVYXL","price":140.0,"currency_code":"EUR","in_stock":true},{"title":"2XL","offer_id":52202164257115,"sku":"SW3115-NAVYXXL","price":140.0,"currency_code":"EUR","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0887\/0726\/8955\/files\/Datum Dahleez-20yr-veyron-ettore-edition-hoodie.jpg?v=1773834528"}],"url":"https:\/\/Datum Dahleez.store\/collections\/sweatshirts-hoodies.oembed","provider":"Datum Dahleez STORE","version":"1.0","type":"link"}